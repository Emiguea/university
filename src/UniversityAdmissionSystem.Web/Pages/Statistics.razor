@page "/statistics"
@inject StatisticsService StatisticsService
@inject AuthService AuthService

<PageTitle>统计报表 - 高校招生录取与新生报到管理系统</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2>统计报表</h2>
        </div>
    </div>

    @if (!AuthService.IsAuthenticated)
    {
        <div class="alert alert-warning">
            请先登录系统。<a href="/login">点击这里登录</a>
        </div>
    }
    else
    {
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">加载中...</span>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-primary shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">录取总人数</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">@totalAdmitted</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-user-graduate fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-success shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">已报到人数</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">@totalRegistered</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-info shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">报到率</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">@registrationRate%</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-chart-line fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-warning shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">已缴费人数</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">@totalPaid</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-money-bill-wave fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xl-6 mb-4">
                    <div class="card shadow mb-4">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-primary">缴费统计</h6>
                        </div>
                        <div class="card-body">
                            <div class="list-group">
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>缴费率</span>
                                    <span class="badge bg-warning rounded-pill">@paymentRate%</span>
                                </div>
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>缴费总额</span>
                                    <span class="badge bg-success rounded-pill">¥@totalPaymentAmount.ToString("N2")</span>
                                </div>
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>未报到人数</span>
                                    <span class="badge bg-danger rounded-pill">@(totalAdmitted - totalRegistered)</span>
                                </div>
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>未缴费人数</span>
                                    <span class="badge bg-danger rounded-pill">@(totalAdmitted - totalPaid)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-6 mb-4">
                    <div class="card shadow mb-4">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-primary">报到与缴费进度</h6>
                        </div>
                        <div class="card-body">
                            <h4 class="small font-weight-bold">报到进度 <span class="float-right">@registrationRate%</span></h4>
                            <div class="progress mb-4">
                                <div class="progress-bar bg-success" role="progressbar"
                                     style="width: @registrationRate%"
                                     aria-valuenow="@registrationRate"
                                     aria-valuemin="0"
                                     aria-valuemax="100"></div>
                            </div>
                            
                            <h4 class="small font-weight-bold">缴费进度 <span class="float-right">@paymentRate%</span></h4>
                            <div class="progress mb-4">
                                <div class="progress-bar bg-warning" role="progressbar"
                                     style="width: @paymentRate%"
                                     aria-valuenow="@paymentRate"
                                     aria-valuemin="0"
                                     aria-valuemax="100"></div>
                            </div>

                            <div class="mt-4">
                                <div class="alert alert-info">
                                    <strong>说明：</strong><br />
                                    - 报到率 = 已报到人数 / 录取总人数 × 100%<br />
                                    - 缴费率 = 已缴费人数 / 录取总人数 × 100%
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xl-12 mb-4">
                    <div class="card shadow mb-4">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-primary">数据概览</h6>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>统计项</th>
                                            <th>数值</th>
                                            <th>占比</th>
                                            <th>状态</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>录取总人数</td>
                                            <td>@totalAdmitted</td>
                                            <td>100%</td>
                                            <td><span class="badge bg-primary">基准</span></td>
                                        </tr>
                                        <tr>
                                            <td>已报到人数</td>
                                            <td>@totalRegistered</td>
                                            <td>@registrationRate%</td>
                                            <td><span class="badge @(registrationRate >= 80 ? "bg-success" : registrationRate >= 50 ? "bg-warning" : "bg-danger")">@(registrationRate >= 80 ? "良好" : registrationRate >= 50 ? "一般" : "偏低")</span></td>
                                        </tr>
                                        <tr>
                                            <td>未报到人数</td>
                                            <td>@(totalAdmitted - totalRegistered)</td>
                                            <td>@Math.Round(100 - registrationRate, 2)%</td>
                                            <td><span class="badge bg-secondary">待跟进</span></td>
                                        </tr>
                                        <tr>
                                            <td>已缴费人数</td>
                                            <td>@totalPaid</td>
                                            <td>@paymentRate%</td>
                                            <td><span class="badge @(paymentRate >= 80 ? "bg-success" : paymentRate >= 50 ? "bg-warning" : "bg-danger")">@(paymentRate >= 80 ? "良好" : paymentRate >= 50 ? "一般" : "偏低")</span></td>
                                        </tr>
                                        <tr>
                                            <td>缴费总额</td>
                                            <td>¥@totalPaymentAmount.ToString("N2")</td>
                                            <td>-</td>
                                            <td><span class="badge bg-info">累计</span></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private int totalAdmitted;
    private int totalRegistered;
    private decimal registrationRate;
    private int totalPaid;
    private decimal paymentRate;
    private decimal totalPaymentAmount;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated)
        {
            await LoadStatistics();
        }
    }

    private async Task LoadStatistics()
    {
        isLoading = true;
        
        totalAdmitted = await StatisticsService.GetTotalAdmittedStudentsAsync();
        totalRegistered = await StatisticsService.GetTotalRegisteredStudentsAsync();
        registrationRate = await StatisticsService.GetRegistrationRateAsync();
        totalPaid = await StatisticsService.GetTotalPaidStudentsAsync();
        paymentRate = await StatisticsService.GetPaymentRateAsync();
        totalPaymentAmount = await StatisticsService.GetTotalPaymentAmountAsync();
        
        isLoading = false;
    }
}