@page "/registrations"
@inject AuthService AuthService

<PageTitle>报到管理 - 高校招生录取与新生报到管理系统</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2>报到管理</h2>
        </div>
    </div>

    @if (!AuthService.IsAuthenticated)
    {
        <div class="alert alert-warning">
            请先登录系统。<a href="/login">点击这里登录</a>
        </div>
    }
    else
    {
        <div class="card shadow">
            <div class="card-body">
                <h5 class="card-title">新生报到登记</h5>
                <p class="text-muted">在此页面可以进行新生现场报到登记和查询报到状态。</p>
                
                <div class="alert alert-info">
                    <strong>功能说明：</strong>
                    <ul class="mb-0">
                        <li>新生现场报到登记</li>
                        <li>录入报到信息（报到时间、地点、登记人）</li>
                        <li>查询学生报到状态</li>
                        <li>支持取消报到（如需）</li>
                    </ul>
                </div>

                <div class="row mt-4">
                    <div class="col-md-6">
                        <div class="card border-info">
                            <div class="card-header bg-info text-white">
                                快速操作
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label class="form-label">学生ID</label>
                                    <input type="text" class="form-control" placeholder="请输入学生ID" @bind="studentId" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">报到地点</label>
                                    <input type="text" class="form-control" placeholder="请输入报到地点" @bind="registrationLocation" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">登记人</label>
                                    <input type="text" class="form-control" placeholder="请输入登记人姓名" @bind="registrar" />
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-success" disabled="true">
                                        <i class="fas fa-check-circle me-2"></i>登记报到
                                    </button>
                                    <button class="btn btn-warning" disabled="true">
                                        <i class="fas fa-undo me-2"></i>取消报到
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card border-secondary">
                            <div class="card-header bg-secondary text-white">
                                报到状态统计
                            </div>
                            <div class="card-body">
                                <div class="list-group">
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>已报到人数</span>
                                        <span class="badge bg-success rounded-pill">-</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>未报到人数</span>
                                        <span class="badge bg-warning rounded-pill">-</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>报到率</span>
                                        <span class="badge bg-info rounded-pill">-</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string studentId = string.Empty;
    private string registrationLocation = string.Empty;
    private string registrar = string.Empty;
}